generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  viewed
  applied
  interviewed
  rejected
  cancelled
}

enum CandidateStatus {
  new
  reviewed
  promoted
  dismissed
}

enum CompanyStatus {
  pursue    // tier 1 — active pursuit
  watch     // tier 2 — monitor and outreach
  network   // focus on direct outreach, not applications
  applied   // active application(s) in progress
  exclude   // off the list
}

model Job {
  id             String    @id @default(uuid())
  title          String
  company        String
  url            String?
  rawDescription String
  salary         String?
  location       String?
  remote         Boolean   @default(false)

  matchScore     Int?
  matchReasons   String?   // JSON array stored as string
  concerns       String?   // JSON array stored as string
  resumeTweaks   String?   // JSON array stored as string

  status         JobStatus @default(viewed)

  contacts       Contact[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Candidates are jobs discovered by the daily search agent.
// They are staged here for review before being promoted into Job.
model Candidate {
  id             String          @id @default(uuid())
  title          String
  company        String
  url            String?         @unique
  rawDescription String?
  salary         String?
  location       String?
  remote         Boolean         @default(false)

  source         String?         // e.g., "linkedin", "ashby", "lever", "company-careers"
  searchQuery    String?         // the query that found it

  matchScore     Int?
  matchReasons   String?         // JSON array stored as string
  concerns       String?         // JSON array stored as string

  status         CandidateStatus @default(new)

  discoveredAt   DateTime        @default(now())
  reviewedAt     DateTime?
  promotedJobId  String?         // jobs.id if promoted

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, discoveredAt])
  @@index([company])
}

model Company {
  id        String        @id @default(uuid())
  name      String        @unique
  status    CompanyStatus @default(watch)
  why       String?
  notes     String?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  role        String?
  linkedIn    String?
  reachedOut  Boolean  @default(false)

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
