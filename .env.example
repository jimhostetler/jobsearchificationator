# Database (SQLite - relative path from prisma folder)
DATABASE_URL="file:./dev.db"

# Anthropic API Key for job scoring
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY="your-api-key-here"

# Google Docs ID for master resume (the part of the URL between /document/d/ and the next /)
# The document must be shared as "Anyone with the link can view"
# Example URL: https://docs.google.com/document/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/edit
# Example ID:  1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_DOCS_RESUME_ID="your-google-doc-id-here"
